<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        width: 100%;
        box-sizing: border-box;
        font-family: "Times New Roman", serif;
        font-size: 16px;
        background-color: #f0f0f0;
        
      }

      .main {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        width: 100%;
      }

      .emailReceive {
        padding: 30px 20px;
        margin: 0 auto;
        max-width: 600px;
      }

      .emailReceive img {
        width: 120px;
        height: auto;
        display: block;
        margin: 0 auto ;
        padding: 10px;
      }

      .emailReceive p {
        margin: 15px 0;
        line-height: 1.6;
        font-size: 1rem;
        color: #333;
      }

      .button-wrapper {
        text-align: center;
        margin-top: 20px;
      }

      .accept-button {
        padding: 10px 20px;
        background-color: #1ab394;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 1rem;
        transition: background-color 0.3s ease;
      }

      .accept-button:hover {
        background-color: #159a7b;
      }
 

      @media (max-width: 480px) {
       

        .emailReceive img {
          width: 80px;
        }

        .accept-button {
          padding: 10px 15px;
          font-size: 0.8rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="main">
      <div class="emailReceive">
        <div style="background-color: #31b394; cursor: pointer">
          <img src="uploads/nutriumLogo.png" alt="Nutrium Logo" />
        </div>
        <p>
          <span style="font-family: 'Open Sans', sans-serif; font-size: 1.75rem; font-weight: bold">
            Access to Nutrium mobile app
          </span>
        </p>

        <p>
          <span style="font-family: 'Open Sans', sans-serif; font-size: 1rem">
            Hello, Example client
          </span>
        </p>
        <p>
          <span style="font-family: 'Calibri', sans-serif; font-size: 1rem">
            You are receiving this email so you can set your password on the Nutrium
            mobile app.
          </span>
        </p>
        <p>
          <span style="font-family: 'Open Sans', sans-serif; font-size: 1.25rem; font-weight: bold">
            App benefits
          </span>
        </p>
        <p>
          <span style="font-family: 'Calibri', sans-serif; font-size: 1rem">
            With Nutrium, you will be able to check your meal plan, get
            notifications at meal times, register measurements, check upcoming
            appointments, and send messages to your nutrition professional.
          </span>
        </p>
        <p>
          <span style="font-family: 'Open Sans', sans-serif; font-size: 1.25rem; font-weight: bold">
            Instructions for use
          </span>
        </p>
        <p>
          <span style="font-family: 'Calibri', sans-serif; font-size: 1rem">
            After downloading the app (available on
            <span style="color: #31b394">Google Play</span> and
            <span style="color: #31b394">App Store</span>), make sure to log in
            with your email and password to access.
          </span>
        </p>
        <p>
          <span style="font-family: 'Calibri', sans-serif; font-size: 1rem">
            To set your password, simply click on the button at the bottom of this
            email.
          </span>
        </p>
        <p>
          <span style="font-family: 'Open Sans', sans-serif; font-size: 1.25rem; font-weight: bold">
            Terms of use
          </span>
        </p>
        <p>
          <span style="font-family: 'Calibri', sans-serif; font-size: 1rem">
            By using our services/application, you agree to our <span style="color: #31b394;">Terms and
              Conditions of Use</span> and our <span style="color: #31b394;">Privacy Policy</span>.
          </span>
        </p>
        <p>
          <span style="font-family: 'Calibri', sans-serif; font-size: 1rem">
            For more information or questions related to your personal data, please contact us at <span style="color: #31b394;">support@inutium.com.</span>
          </span>
        </p>
        <div class="button-wrapper">
          <form>
            <a class="accept-button"
            href="<%= updateUrl %>"
            target="_blank"
            rel="noopener noreferrer"
            type="submit">Set Password</a>
          </form>
        </div>
      </div>
    </div>
  </body>
</html>
